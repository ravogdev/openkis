# Caddy: HTTPS reverse proxy in front of OpenKIS (compose profile "https").
# OPENKIS_DOMAIN comes from .env. Caddy gets and renews a Let's Encrypt
# certificate for it, redirects HTTP to HTTPS and sends X-Forwarded-Proto,
# which Apache in the web container honours.
{$OPENKIS_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
	# The data folder is never served by its path: record files go through
	# openkis_file.php, which checks who may read them. Apache in the web
	# container already refuses it; this keeps it closed at the front end too.
	@datafolder path /misc/fndatabase /misc/fndatabase/*
	respond @datafolder 403
	reverse_proxy web:80
}
