# Copy to .env and change the passwords.

# Host port for the web server (http://localhost:8080/). With HTTPS on, use
# 127.0.0.1:8080 so the plain HTTP port is not reachable from outside.
OPENKIS_HTTP_PORT=8080

# HTTPS with Caddy (automatic Let's Encrypt certificate). Empty = off, as before.
# To turn it on: COMPOSE_PROFILES=https and OPENKIS_DOMAIN=your domain, whose
# DNS points at this server, with ports 80 and 443 open.
COMPOSE_PROFILES=
OPENKIS_DOMAIN=
#OPENKIS_CADDY_HTTP_PORT=80
#OPENKIS_CADDY_HTTPS_PORT=443
TZ=Europe/Rome

# Database (MariaDB container). The app connects as OPENKIS_DB_USER.
OPENKIS_DB_NAME=openkis
OPENKIS_DB_USER=openkis
OPENKIS_DB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-too

# Where data is stored on the host. Empty = Docker named volumes
# (openkis_www, openkis_db), as before. Set a path (absolute, or ./relative
# to this folder) to keep the data in a host folder instead, e.g. on a
# dedicated disk. Missing folders are created on first start.
#   OPENKIS_DATA_DIR    -> web root /var/www/html (code + misc/: uploads, data)
#   OPENKIS_DB_DATA_DIR -> MariaDB data /var/lib/mysql
OPENKIS_DATA_DIR=
OPENKIS_DB_DATA_DIR=

# Regional customisation: a folder in extra/openkis/custom/
# (example, italia, liguria, lombardia, marche, piemonte, umbria, wish).
# Empty = generic installation.
OPENKIS_CUSTOM=

# Landing page (a folder in sections/). The default "home" is the WISH
# national portal; a regional site usually wants "map_caves" (cave map
# centred on the region) or "caves" (cave list). Empty = the home section
# chosen in the control center (Settings).
OPENKIS_HOME_SECTION=

# MCP API (openkis_mcp.php), legacy global key with full access: disabled while empty
OPENKIS_MCP_APIKEY=
OPENKIS_MCP_USER=admin
OPENKIS_MCP_READONLY=0
# Personal API keys (Configuration > MCP server): groups whose members may use a key
# and groups allowed to use the write tools, comma separated. Admins always can.
# Empty = the defaults, mcp_users and mcp_write.
OPENKIS_APIKEY_GROUPS=
OPENKIS_MCP_WRITE_GROUP=

# Optional map / search keys (written to the api_keys.local.js files)
THUNDERFOREST_API_KEY=
MAPTILER_API_KEY=
ALGOLIA_DOCSEARCH_API_KEY=

# PHP errors in the page (on = development only: warnings break exports)
OPENKIS_DISPLAY_ERRORS=off

# openkis_proxy.php fetches map tiles for the browser, only from the hosts of
# the proxied layers in bs_map/conf/layers_*.js and the site's own host; only
# the Lombardia IGM and geological layers need it. 1 = enable.
OPENKIS_ENABLE_PROXY=0
# More hosts the proxy may fetch from, comma separated (e.g. wms.example.org).
# Empty = only the layer hosts and the site's own host.
OPENKIS_PROXY_HOSTS=

# Reverse proxies whose X-Forwarded-For gives the visitor's address (the login
# lockout counts wrong passwords per username and address). Addresses or CIDR
# ranges; docker (default) = the other containers on the web container's
# networks, such as the bundled Caddy; none = off. A proxy on the host or on
# another machine is added by address, e.g. docker,172.18.0.1
OPENKIS_TRUSTED_PROXIES=docker

# Record validator (banner in the cave/artificial edit forms): rules to switch
# off, comma separated, overriding the region's rules. Keys: name, description,
# coordinates, reference_system, elevation, comune, provincia, speleometric,
# depth_total (or the label of a regional rule); all = no banner. Empty = all on.
OPENKIS_VALIDATOR_RULES_OFF=

# Database indexes (sql/openkis_indexes.sql, see INDEXES.md): applied at start
# and then every OPENKIS_DB_INDEXES_INTERVAL seconds, because OpenKIS creates
# tables on first use. 0 = off / only at start.
OPENKIS_DB_INDEXES=1
OPENKIS_DB_INDEXES_INTERVAL=3600

# Web image (default robydoc/openkis-web:latest, which moves with every develop
# merge; pin a dated tag such as robydoc/openkis-web:2026-10-25.1 in production).
# openkis-web:local = your own build.
#OPENKIS_IMAGE=robydoc/openkis-web:latest
