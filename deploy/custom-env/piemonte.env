# OpenKIS site for the Piemonte regional cave register.
# From the deploy/ folder, after changing the two passwords:
#   docker compose --env-file custom-env/piemonte.env up -d
# Then open http://localhost:8086/ and run the install wizard
# (the first user registered becomes the admin).
#
# Its own project name, port and database, so it can run next to other sites.

COMPOSE_PROJECT_NAME=openkis_piemonte

# With HTTPS on (COMPOSE_PROFILES=https), use 127.0.0.1:8086 so the plain HTTP
# port listens only on the loopback address and is not reachable from outside.
OPENKIS_HTTP_PORT=8086
TZ=Europe/Rome

OPENKIS_DB_NAME=openkis_piemonte
OPENKIS_DB_USER=openkis
OPENKIS_DB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-too

# Regional customisation (extra/openkis/custom/piemonte)
OPENKIS_CUSTOM=piemonte
# Landing page: the cave map centred on Piemonte instead of the WISH portal
OPENKIS_HOME_SECTION=map_caves

# openkis_proxy.php (map tiles from the map layer hosts only): only the Lombardia map layers need it
OPENKIS_ENABLE_PROXY=0
# more hosts the proxy may fetch from, comma separated; empty = layer hosts only
OPENKIS_PROXY_HOSTS=

# Reverse proxies whose X-Forwarded-For gives the visitor's address (the login
# lockout counts wrong passwords per username and address). Addresses or CIDR
# ranges; docker (default) = the other containers on the web container's
# networks, such as the bundled Caddy; none = off. A proxy on the host or on
# another machine is added by address, e.g. docker,172.18.0.1
OPENKIS_TRUSTED_PROXIES=docker

# Record validator (banner in the cave/artificial edit forms): rules to switch
# off, comma separated, overriding the region's rules. Keys: name, description,
# coordinates, reference_system, elevation, comune, provincia, speleometric,
# depth_total (or the label of a regional rule); all = no banner. Empty = all on.
OPENKIS_VALIDATOR_RULES_OFF=

OPENKIS_MCP_APIKEY=
OPENKIS_MCP_USER=admin
OPENKIS_MCP_READONLY=0
# Personal API keys (Configuration > MCP server): groups whose members may use a key
# and groups allowed to use the write tools, comma separated. Admins always can.
# Empty = the defaults, mcp_users and mcp_write.
OPENKIS_APIKEY_GROUPS=
OPENKIS_MCP_WRITE_GROUP=

THUNDERFOREST_API_KEY=
MAPTILER_API_KEY=
ALGOLIA_DOCSEARCH_API_KEY=

OPENKIS_DISPLAY_ERRORS=off

# Web image (default robydoc/openkis-web:latest)
#OPENKIS_IMAGE=robydoc/openkis-web:latest
